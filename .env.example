# ============================================================
# PM Automation - example environment
# Copy to .env and fill in your own values.
# ============================================================

# --- Email (IMAP) ---
EMAIL_HOST=imap.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=
IMAP_PORT=993
IMAP_INBOX=INBOX
IMAP_FOLDER_PROCESSED=INBOX/Processed

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Internal ---
ADMIN_EMAIL=
APP_NAME=PM Automation

# --- WhatsApp / Waha ---
WAHA_API_URL=http://127.0.0.1:3000
WAHA_SESSION=default
WHATSAPP_PHONE=
WAHA_API_KEY=

# --- Automation ---
AUTOMATION_ENABLED=true
AUTOMATION_POLL_SECONDS=60
AUTOMATION_MARK_PROCESSED=false

# --- AI itinerary (DeepSeek, OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60
ITINERARY_ENGINE=auto
