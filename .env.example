# ============================================================
# PM Automation - example environment
# Copy to .env and fill in your own values.
# ============================================================

# --- Email (IMAP) ---
EMAIL_HOST=imap.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=
IMAP_PORT=993
IMAP_INBOX=INBOX
IMAP_FOLDER_PROCESSED=INBOX/Processed

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Internal ---
ADMIN_EMAIL=
APP_NAME=PM Automation

# --- WhatsApp / Waha ---
WAHA_API_URL=http://127.0.0.1:3000
WAHA_SESSION=default
WHATSAPP_PHONE=
WAHA_API_KEY=

# --- Automation ---
AUTOMATION_ENABLED=true
AUTOMATION_POLL_SECONDS=60
AUTOMATION_MARK_PROCESSED=false

# --- AI itinerary (LLM providers, OpenAI-compatible) ---
# AI_PROVIDER: auto (DeepSeek key first, then OpenAI), deepseek, openai, or rule
AI_PROVIDER=auto
ITINERARY_ENGINE=auto

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=60

# --- Live web search (DuckDuckGo, keyless) ---
WEB_SEARCH_ENABLED=true
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=20
